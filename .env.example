# --- TradingBot secrets -------------------------------------------------
# Copy to `.env` and fill in. NEVER commit `.env`. Keys are read from the
# environment only; nothing in config.yaml holds secrets.
#
# For paper trading and backtesting you do NOT need API keys at all:
# historical/live candles are fetched from Binance public endpoints.

# Only needed for LIVE trading. Create keys with:
#   - withdrawals DISABLED
#   - IP restriction ENABLED
#   - spot trading only
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Live-trading acknowledgement. Live orders are refused unless this variable
# is set to EXACTLY the string below AND config live.enabled=true AND the CLI
# flag --i-really-want-live is passed. Leave empty for paper trading.
# TRADINGBOT_LIVE_ACK=I-UNDERSTAND-LIVE-TRADING-RISKS-AND-ACCEPT-LOSSES
TRADINGBOT_LIVE_ACK=
